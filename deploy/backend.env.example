# Copy to backend.env.local. Never commit the filled file.
APP_ENV=production
AUTH_MODE=supabase
CONTENTOPS_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_POOLER_HOST:5432/postgres?sslmode=require&options=-c%20search_path%3Dcontentops
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
CONTENTOPS_OWNER_USER_ID=REPLACE_OWNER_UUID
MCP_OAUTH_CLIENT_ID=REPLACE_CLIENT_UUID
MCP_PUBLIC_URL=https://REPLACE_BACKEND_HOST/mcp
FRONTEND_ORIGIN=https://REPLACE_WEB_HOST
MCP_HOST=0.0.0.0
