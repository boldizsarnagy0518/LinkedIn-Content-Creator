{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "contentops-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "contentops-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "contentops-web-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve:local"
      ],
      "port": 3000
    }
  ]
}
